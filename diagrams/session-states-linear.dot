// Charging session state machine, naive reading: a single happy-path chain
// that falls into Faulted only at the end.
// Rendered by ../render-diagrams.sh (system graphviz).
digraph session_states_linear {
  rankdir=TB
  splines=ortho
  bgcolor="transparent"
  nodesep=0.45
  ranksep=0.85

  node [shape=box style="rounded,filled" fillcolor="#eef3f7" color="#12303f"
        fontcolor="#1f2933" fontname="Source Sans Pro,Helvetica" fontsize=13
        penwidth=1.2 width=1.5 height=0.55 fixedsize=true]

  Faulted [fillcolor="#f7eeee" color="#993d3d" fontcolor="#993d3d"]

  // happy path
  edge [color="#0b6e99" penwidth=1.5 arrowsize=0.8]
  Idle -> Preparing -> Charging -> Finishing
  Finishing -> Idle [constraint=false]

  // the one exception path this reading accounts for
  edge [color="#993d3d" penwidth=1.5 arrowsize=0.8]
  Finishing -> Faulted
}
